# Copy to .env and paste your keys. .env is gitignored; never commit real keys.
# Tripo: https://platform.tripo3d.ai -> API Keys (starts with tsk_)
TRIPO_API_KEY=
# Backup Tripo account (used when the first runs out of credits)
TRIPO_API_KEY_2=
# Meshy: https://www.meshy.ai/settings/api (paid plan only; leave blank if free)
MESHY_API_KEY=
# Backup Meshy account
MESHY_API_KEY_2=
